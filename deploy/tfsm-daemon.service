[Unit]
Description=The Football Smart Manager - scoring + settlement daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tfsm
WorkingDirectory=/home/tfsm/tfsm
EnvironmentFile=/home/tfsm/tfsm/.env
ExecStart=/home/tfsm/tfsm/.venv/bin/tfsm run-daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
