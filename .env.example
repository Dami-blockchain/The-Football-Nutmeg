# ---- Mode -----------------------------------------------------------
# paper | live
BETBOT_MODE=paper

# ---- Football-data.org (required) -----------------------------------
# Get a free API key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_RATE_LIMIT_PER_MIN=10

# ---- Strategy knobs -------------------------------------------------
BETBOT_HOME_ADVANTAGE=0.3
BETBOT_DRAW_SCORE=2.4
BETBOT_SOFTMAX_TEMP=1.0
BETBOT_OPP_STRENGTH_WEIGHT=0.5

# ---- Risk controls --------------------------------------------------
BETBOT_FIXED_STAKE_USD=10
BETBOT_MAX_BET_USD=50
BETBOT_DAILY_EXPOSURE_CAP_USD=200
BETBOT_EDGE_THRESHOLD=0.05

# ---- Storage --------------------------------------------------------
BETBOT_DB_PATH=./data/betbot.sqlite

# ---- Logging --------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
BETBOT_LOG_LEVEL=INFO

# ---- Scheduler ------------------------------------------------------
# Cron expression for run-daemon. UTC. Default: 08:00 every day.
BETBOT_DAEMON_CRON=0 8 * * *
