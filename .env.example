# ---- Mode -----------------------------------------------------------
# paper | live
BETBOT_MODE=paper

# ---- Football-data.org (required) -----------------------------------
# Get a free API key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_RATE_LIMIT_PER_MIN=10

# ---- Strategy knobs -------------------------------------------------
BETBOT_HOME_ADVANTAGE=0.3
BETBOT_DRAW_SCORE=2.4
BETBOT_SOFTMAX_TEMP=1.0
BETBOT_OPP_STRENGTH_WEIGHT=0.5

# ---- Risk controls --------------------------------------------------
BETBOT_FIXED_STAKE_USD=10
BETBOT_MAX_BET_USD=50
BETBOT_DAILY_EXPOSURE_CAP_USD=200
BETBOT_EDGE_THRESHOLD=0.05

# Market-match sanity guard: a 1X2 outcome quoted outside this band is
# implausible and almost always means the fixture was paired to the WRONG
# market (a longshot prop or a different fixture). Such matches are rejected at
# the router so no phantom edge is logged or arb leg formed.
BETBOT_MIN_PLAUSIBLE_PRICE=0.02
BETBOT_MAX_PLAUSIBLE_PRICE=0.98

# ---- Storage --------------------------------------------------------
BETBOT_DB_PATH=./data/betbot.sqlite

# ---- Logging --------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
BETBOT_LOG_LEVEL=INFO

# ---- Scheduler ------------------------------------------------------
# Cron expression for run-daemon. UTC. Default: 08:00 every day.
BETBOT_DAEMON_CRON=0 8 * * *

# ---- Daily Telegram jobs (Africa/Nairobi wall-clock) -----------------
# 09:00 arb digest (broadcast to operator + every registered user) and the
# 21:00 daily report. The FULL report (all users' balances, agent wallet,
# cumulative P&L) goes ONLY to TELEGRAM_ALLOWED_USER_ID; each registered
# user receives a scoped report with only their own wallet's balances.
# Hours are Nairobi-local (named timezone, not a hardcoded UTC offset).
BETBOT_ARB_DIGEST_ENABLED=true
BETBOT_ARB_DIGEST_HOUR=9
BETBOT_DAILY_REPORT_ENABLED=true
BETBOT_DAILY_REPORT_HOUR=21

# ---- Deposit pipeline (CCTP bridging) --------------------------------
# >>> BETBOT_AUTO_BRIDGE is the master gate for EVERY on-chain action the
# >>> pipeline takes (gas top-ups, CCTP burns/mints, venue approvals) and it
# >>> defaults to TRUE: this is a deliberate operator decision — deposits and
# >>> bridging are fund-custody plumbing for a bot going live with real
# >>> funds, independent of BETBOT_MODE (which gates BET PLACEMENT only).
# >>> Set false to disable all pipeline on-chain activity (detect+log only).
BETBOT_AUTO_BRIDGE=true
# Deposits below this many USDC are ignored (logged). Registration alone
# never triggers on-chain spend — only a detected deposit >= this minimum.
BETBOT_MIN_DEPOSIT_USDC=10
# Fraction of each deposit reserved for Base/Limitless (0.0 = 100% Polygon).
BETBOT_BRIDGE_SPLIT_BASE=0.0
# Native gas sent from the agent wallet to user wallets before user-signed txs.
BETBOT_GAS_TOPUP_POL=0.5
BETBOT_GAS_TOPUP_ETH=0.0005
# Abuse guard: max agent-funded gas top-ups per user wallet per UTC day
# (persisted — restarts don't reset it). 0 disables the cap.
BETBOT_GAS_TOPUP_DAILY_CAP=4
BETBOT_DEPOSIT_SCAN_MINUTES=10
ETHEREUM_RPC_URL=https://eth.drpc.org
ARBITRUM_RPC_URL=https://arbitrum.drpc.org
BETBOT_IRIS_API_URL=https://iris-api.circle.com
# Limitless CTF Exchange on Base — required only when BRIDGE_SPLIT_BASE > 0.
LIMITLESS_EXCHANGE=

# ---- Backend API / wallet / Telegram bot ----
TFSM_API_TOKEN=
BETBOT_WALLET_KEYFILE=./.secrets/agent_wallet.key
POLYGON_RPC_URL=https://polygon.drpc.org
BASE_RPC_URL=https://mainnet.base.org
TELEGRAM_BOT_TOKEN=
# Operator chat id: receives the FULL daily report (all balances, P&L) and
# may register onto the agent wallet.
TELEGRAM_ALLOWED_USER_ID=

# ---- Telegram registration (PUBLIC BY DEFAULT — read this) -----------
# >>> TELEGRAM_OPEN_REGISTRATION=true means ANYONE who messages the bot is
# >>> registered: they get their own isolated wallet keyfile on disk, are
# >>> scanned for deposits, and receive their own scoped daily report. This
# >>> is a deliberate operator decision for a public bot. Funds are never
# >>> pooled, registration alone never spends anything on-chain, live bet
# >>> placement stays behind BETBOT_MODE + the gate, and agent gas spend is
# >>> capped per wallet per day (BETBOT_GAS_TOPUP_DAILY_CAP).
# >>> Set false to restrict access to the allowlist below.
TELEGRAM_OPEN_REGISTRATION=true
# Comma-separated extra Telegram user ids allowed to register when open
# registration is off.
TELEGRAM_ALLOWED_USER_IDS=

# Arbitrage execution (heavily gated; OFF by default)
BETBOT_ARB_EXECUTE=false
BETBOT_ARB_EXECUTE_MIN_MARGIN=0.02
BETBOT_ARB_MAX_STAKE_USD=25
BETBOT_ARB_DAILY_CAP_USD=100
