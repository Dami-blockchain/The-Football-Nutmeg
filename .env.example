# ---- Mode -----------------------------------------------------------
# paper | live
BETBOT_MODE=paper

# ---- Football-data.org (required) -----------------------------------
# Get a free API key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_RATE_LIMIT_PER_MIN=10

# ---- Strategy knobs -------------------------------------------------
BETBOT_HOME_ADVANTAGE=0.3
BETBOT_DRAW_SCORE=2.4
BETBOT_SOFTMAX_TEMP=1.0
BETBOT_OPP_STRENGTH_WEIGHT=0.5

# ---- Risk controls --------------------------------------------------
BETBOT_FIXED_STAKE_USD=10
BETBOT_MAX_BET_USD=50
BETBOT_DAILY_EXPOSURE_CAP_USD=200
BETBOT_EDGE_THRESHOLD=0.05

# ---- Storage --------------------------------------------------------
BETBOT_DB_PATH=./data/betbot.sqlite

# ---- Logging --------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
BETBOT_LOG_LEVEL=INFO

# ---- Scheduler ------------------------------------------------------
# Cron expression for run-daemon. UTC. Default: 08:00 every day.
BETBOT_DAEMON_CRON=0 8 * * *

# ---- Cross-venue arbitrage ------------------------------------------
# Alerts: Telegram ping for complete opportunities at/above this margin.
BETBOT_ARB_NOTIFY_MIN_MARGIN=0.01
BETBOT_ARB_SCAN_INTERVAL_MIN=10
BETBOT_ARB_SCAN_LIMIT=80
# EXECUTION (real orders; heavily gated, OFF by default). Even when true,
# also requires mode=live, a clear kill switch, margin >= the execute
# threshold below, and funded balances on BOTH venues.
BETBOT_ARB_EXECUTE=false
# Stricter than the alert threshold on purpose.
BETBOT_ARB_EXECUTE_MIN_MARGIN=0.02
# Total stake per opportunity across all legs.
BETBOT_ARB_MAX_STAKE_USD=25
# Daily cap summed over arb execution attempts that moved (or may have moved) money.
BETBOT_ARB_DAILY_CAP_USD=100

# ---- Limitless live orders ------------------------------------------
# Scoped API auth (X-API-Key, or key+secret for HMAC). Orders need this.
LIMITLESS_API_KEY=
LIMITLESS_API_SECRET=
# Optional override for the per-user fee rate embedded in signed orders.
# 0/unset = fetch the authoritative value from GET /profiles/me rank.feeRateBps.
LIMITLESS_FEE_RATE_BPS=0

# ---- Backend API / wallet / Telegram bot ----
TFSM_API_TOKEN=
BETBOT_WALLET_KEYFILE=./.secrets/agent_wallet.key
POLYGON_RPC_URL=https://polygon.drpc.org
BASE_RPC_URL=https://mainnet.base.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
